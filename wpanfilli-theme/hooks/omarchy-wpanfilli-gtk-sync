#!/bin/bash
# theme-set hook for the "wpanfilli" theme (see omarchy-theme-wpanfilli-render).
# Nautilus/GTK window backgrounds come from ~/.config/gtk-{3,4}.0/gtk.css,
# which Coppernight's apply-filemanager.sh wrote once as a static copy of its
# filemanager-gtk.css -- no theme switch ever updates it. So:
#   - wpanfilli active: write its (wallpaper-tinted) filemanager-gtk.css there
#   - any other theme:  if the file is ours, put Coppernight's original back
#     (the state before wpanfilli existed)
# Only touches files that are ours or Coppernight's (by header), never a
# gtk.css the user wrote.
#
# GTK reads gtk.css only at process start, and Nautilus keeps running as a
# background service (`nautilus --gapplication-service`) after its last
# window closes, so a changed gtk.css never showed up. When it changed and no
# Nautilus window is open, the service is quit so the next window starts
# fresh; open windows are never closed (they update when reopened).
#
# libadwaita's accent color (selection, buttons, switches) DOES update live,
# so it is set to the closest of GNOME's 9 accents to the theme's accent, and
# restored to the previous value when leaving wpanfilli.
set -u
MARK="/* wpanfilli: generated by omarchy-wpanfilli-gtk-sync */"
STATE="$HOME/.local/state/omarchy-wpanfilli"
THEME_NAME=$(cat "$HOME/.local/state/omarchy/current/theme.name" 2>/dev/null)
CURRENT_THEME="$HOME/.local/state/omarchy/current/theme"
RENDERED="$CURRENT_THEME/filemanager-gtk.css"
ORIGINAL="$HOME/.local/share/omarchy-wpanfilli/template/filemanager-gtk.css"
mkdir -p "$STATE"

changed=false
for target in "$HOME/.config/gtk-3.0/gtk.css" "$HOME/.config/gtk-4.0/gtk.css"; do
    [[ -f $target ]] || continue
    if [[ $THEME_NAME == wpanfilli ]]; then
        grep -qF -e "$MARK" -e "Coppernight file manager background" "$target" || continue
        [[ -f $RENDERED ]] || continue
        new=$({ echo "$MARK"; cat "$RENDERED"; })
        if [[ $new != "$(<"$target")" ]]; then
            printf '%s\n' "$new" >"$target.tmp" && mv "$target.tmp" "$target"
            changed=true
        fi
    elif grep -qF "$MARK" "$target" && [[ -f $ORIGINAL ]]; then
        cp "$ORIGINAL" "$target"
        changed=true
    fi
done

if [[ $changed == true ]] && pgrep -x nautilus >/dev/null; then
    # One background waiter at most (flock): quits the service as soon as no
    # Nautilus window is open -- right away if none is. Gives up after 12h.
    setsid -f flock -n "$STATE/nautilus-restart.lock" bash -c '
        for _ in $(seq 8640); do
            pgrep -x nautilus >/dev/null || exit 0
            if ! hyprctl clients -j 2>/dev/null | grep -q "\"class\": \"org.gnome.Nautilus\""; then
                nautilus -q 2>/dev/null
                exit 0
            fi
            sleep 5
        done' >/dev/null 2>&1 </dev/null
fi

# libadwaita accent color.
if [[ $THEME_NAME == wpanfilli ]]; then
    [[ -f $STATE/accent-color.before ]] ||
        gsettings get org.gnome.desktop.interface accent-color >"$STATE/accent-color.before"
    accent=$(sed -nE 's/^accent\s*=\s*"#?([0-9a-fA-F]{6})".*/\1/p' "$CURRENT_THEME/colors.toml" | head -1)
    if [[ -n $accent ]]; then
        name=$(python3 - "$accent" <<'PY'
import colorsys, sys
h = sys.argv[1]
hh, l, s = colorsys.rgb_to_hls(*(int(h[i:i+2], 16) / 255 for i in (0, 2, 4)))
# GNOME 47+ accent palette (libadwaita).
ref = {"blue": "3584e4", "teal": "2190a4", "green": "3a944a", "yellow": "c88800",
       "orange": "ed5b00", "red": "e62d42", "pink": "d56199", "purple": "9141ac",
       "slate": "6f8396"}
def d(r):
    rh, rl, rs = colorsys.rgb_to_hls(*(int(r[i:i+2], 16) / 255 for i in (0, 2, 4)))
    if s < 0.2:
        return 0 if r == "6f8396" else 9
    dh = min(abs(hh - rh), 1 - abs(hh - rh))
    return dh * 4 + abs(s - rs) * 0.3
print(min(ref, key=lambda k: d(ref[k])))
PY
)
        gsettings set org.gnome.desktop.interface accent-color "$name"
    fi
elif [[ -f $STATE/accent-color.before ]]; then
    gsettings set org.gnome.desktop.interface accent-color "$(tr -d "'" <"$STATE/accent-color.before")"
    rm -f "$STATE/accent-color.before"
fi
